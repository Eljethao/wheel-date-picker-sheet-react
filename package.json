{
  "name": "wheel-date-picker-sheet",
  "version": "0.1.1",
  "description": "A modern React date and time picker shown as a bottom sheet with scrolling day / month / year (and hour / minute) wheels. dd/MM/yyyy preview, future dates, English and Lao labels built in.",
  "keywords": [
    "react",
    "date-picker",
    "datepicker",
    "time-picker",
    "bottom-sheet",
    "wheel",
    "mobile",
    "lao"
  ],
  "license": "MIT",
  "author": "ljthao",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "screenshots"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/style.css dist/style.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "puppeteer-core": "25.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
